o Kicker
# A proper wedge kicker with hard edges and correct CCW winding.
# 18 vertices total to support duplicated positions for different face normals.

# Ramp surface (Normal: 0, 0.707, 0.707)
v -0.5 0.0 0.5
v 0.5 0.0 0.5
v 0.5 1.0 -0.5
v -0.5 1.0 -0.5

# Bottom surface (Normal: 0, -1, 0)
v -0.5 0.0 0.5
v 0.5 0.0 0.5
v 0.5 0.0 -0.5
v -0.5 0.0 -0.5

# Back surface (Normal: 0, 0, -1)
v 0.5 0.0 -0.5
v -0.5 0.0 -0.5
v -0.5 1.0 -0.5
v 0.5 1.0 -0.5

# Left side (Normal: -1, 0, 0)
v -0.5 0.0 0.5
v -0.5 1.0 -0.5
v -0.5 0.0 -0.5

# Right side (Normal: 1, 0, 0)
v 0.5 0.0 0.5
v 0.5 0.0 -0.5
v 0.5 1.0 -0.5

vt 0 0
vt 1 0
vt 1 1
vt 0 1

vn 0 0.707 0.707
vn 0 -1 0
vn 0 0 -1
vn -1 0 0
vn 1 0 0

# Faces (triangulated)
# Ramp
f 1/1/1 2/2/1 3/3/1
f 1/1/1 3/3/1 4/4/1
# Bottom
f 8/4/2 7/3/2 6/2/2
f 8/4/2 6/2/2 5/1/2
# Back
f 9/1/3 12/4/3 11/3/3
f 9/1/3 11/3/3 10/2/3
# Left
f 13/1/4 14/2/4 15/3/4
# Right
f 16/1/5 17/2/5 18/3/5
