# Bank (Wedge ramp)
v -1.0 0.0 -1.0
v 1.0 0.0 -1.0
v 1.0 0.0 1.0
v -1.0 0.0 1.0
v -1.0 0.5 1.0
v 1.0 0.5 1.0

vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0

vn 0.0 -1.0 0.0
vn 0.0 0.0 1.0
vn 0.0 0.89 -0.44
vn -1.0 0.0 0.0
vn 1.0 0.0 0.0

# Bottom
f 4/4/1 3/3/1 2/2/1
f 2/2/1 1/1/1 4/4/1
# Back
f 3/2/2 4/1/2 5/4/2
f 5/4/2 6/3/2 3/2/2
# Slope
f 1/1/3 2/2/3 6/3/3
f 6/3/3 5/4/3 1/1/3
# Left
f 1/1/4 5/2/4 4/3/4
# Right
f 2/1/5 3/2/5 6/3/5